{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Edge Resource Manager (Flask)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Run Test Cases TC01-TC07",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "tests", "-v"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
